<?xml version="1.0" encoding="utf-8"?>
<!-- Everything is HTTPS, except the public price files of chains hosted on binaprojects.com,
     which are only served over plain HTTP. No personal data is sent there. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">binaprojects.com</domain>
    </domain-config>
</network-security-config>

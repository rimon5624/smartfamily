<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Photos taken for item recognition; deleted after use -->
    <cache-path name="photos" path="photos/" />
    <!-- Appliance manuals kept on this phone, opened in a PDF viewer -->
    <files-path name="manuals" path="manuals/" />
    <!-- Decrypted chat media, opened in another app on request -->
    <cache-path name="chat" path="chat/" />
    <!-- Calendar files shared with the phone calendar -->
    <cache-path name="ics" path="ics/" />
    <!-- Lists, cards and invites shared as images -->
    <cache-path name="share" path="share/" />
</paths>
